{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (release)",
      "type": "shell",
      "command": "make -j8",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build (debug)",
      "type": "shell",
      "command": "make debug"
    },
    {
      "label": "build (asan)",
      "type": "shell",
      "command": "make asan"
    },
    {
      "label": "run tests",
      "type": "shell",
      "command": "./bin/tests",
      "dependsOn": ["build (release)"]
    },
    {
      "label": "bench quick",
      "type": "shell",
      "command": "./bin/bench --nodes 100000 --seconds 5 --clients 8",
      "dependsOn": ["build (release)"]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean"
    }
  ]
}
